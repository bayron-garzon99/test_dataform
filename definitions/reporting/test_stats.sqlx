config {
  type: "table",
  tags: ["reporting", "daily"],
  description: "This table contains all information about test, bringing all mongo test.",
  columns: {    
    test: "test column with some description",
  },
  assertions: {
    nonNull: ["test"],
    uniqueKey: ["test"]
  },
  redshift: {
    distStyle: "key",
    distKey: "id"
  }
}